# ============================================================
# 환경 변수 설정 예제 파일 (.env.example)
# 
# 사용 방법:
# 1. 이 파일을 .env.local로 복사하세요
#    cp .env.example .env.local
# 
# 2. .env.local 파일에서 실제 값으로 수정하세요
#    (특히 DB_PASSWORD, JWT_SECRET 등)
# ============================================================

# Spring Profile
SPRING_PROFILES_ACTIVE=local

# Server 설정
SERVER_PORT=8080
INCLUDE_STACKTRACE=on_param

# ============================================================
# 데이터베이스 설정 (Docker MySQL)
# ============================================================
DB_URL=jdbc:mysql://localhost:3306/music_sale_db
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_USERNAME=root
DB_PASSWORD=password

# HikariCP Connection Pool 설정
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# ============================================================
# JPA 설정 (로컬 개발 환경)
# ============================================================
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
JPA_USE_SQL_COMMENTS=true
JPA_DEFER_DATASOURCE_INIT=true
JPA_SQL_INIT_MODE=never
JPA_DIALECT=org.hibernate.dialect.MySQLDialect

# ============================================================
# Redis 설정 (Docker Redis)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2000ms
REDIS_MAX_ACTIVE=8
REDIS_MAX_IDLE=8
REDIS_MIN_IDLE=0
REDIS_MAX_WAIT=-1ms

# ============================================================
# JWT 설정
# ============================================================
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-secure
JWT_EXPIRATION_MS=86400000

# ============================================================
# OAuth2 설정 (소셜 로그인)
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ============================================================
# 로깅 설정
# ============================================================
LOGGING_LEVEL_COM_MUSIC_SALE=DEBUG
LOGGING_LEVEL_SECURITY=INFO
LOGGING_LEVEL_HIBERNATE_SQL=DEBUG
LOGGING_LEVEL_HIBERNATE_PARAMS=TRACE
