# ============================================
# Music Sale Platform - 환경 변수 설정
# ============================================
# 이 파일을 복사하여 .env 파일을 생성하세요:
#   cp .env.example .env
#
# 환경별 권장 설정:
#   - local: H2 + Simple Cache (Docker 불필요)
#   - dev: MySQL + Redis (Docker 필요)
#   - prod: MySQL + Redis (보안 강화)
# ============================================

# ===========================================
# 1. 기본 설정
# ===========================================
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
INCLUDE_STACKTRACE=on_param  # local: on_param, prod: never

# ===========================================
# 2. 서버 성능 (Tomcat)
# ===========================================
SERVER_TOMCAT_MAX_THREADS=200           # 최대 요청 처리 스레드
SERVER_TOMCAT_MIN_SPARE_THREADS=10      # 최소 대기 스레드
SERVER_TOMCAT_ACCEPT_COUNT=100          # 대기열 크기
SERVER_TOMCAT_CONNECTION_TIMEOUT=20000  # 연결 타임아웃 (ms)
SERVER_TOMCAT_MAX_CONNECTIONS=8192      # 최대 동시 연결 수

# ===========================================
# 3. 데이터베이스 (HikariCP)
# ===========================================
# 기본값: H2 인메모리 (local)
# MySQL 사용 시 아래 주석 해제
#DB_URL=jdbc:h2:mem:testdb
#DB_DRIVER=org.h2.Driver
#DB_USERNAME=sa
#DB_PASSWORD=

# --- MySQL 설정 (dev/prod) ---
 DB_URL=jdbc:mysql://localhost:3306/music_sale_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
 DB_DRIVER=com.mysql.cj.jdbc.Driver
 DB_USERNAME=music_user
 DB_PASSWORD=music_password

# --- 커넥션 풀 설정 ---
DB_MAX_POOL_SIZE=10                 # local: 5, prod: 20-50
DB_MIN_IDLE=5                       # local: 2, prod: 10
DB_CONNECTION_TIMEOUT=30000         # 커넥션 획득 대기 (ms)
DB_IDLE_TIMEOUT=600000              # 유휴 커넥션 유지 시간 (ms)
DB_MAX_LIFETIME=1800000             # 커넥션 최대 수명 (ms)
DB_LEAK_DETECTION_THRESHOLD=0       # 커넥션 누수 감지 (0=비활성화, prod: 60000)
DB_VALIDATION_TIMEOUT=5000          # 커넥션 유효성 검사 타임아웃 (ms)

# ===========================================
# 4. JPA/Hibernate
# ===========================================
JPA_DDL_AUTO=create-drop            # local: create-drop, dev: update, prod: validate
JPA_FORMAT_SQL=true                 # local: true, prod: false
JPA_USE_SQL_COMMENTS=true           # local: true, prod: false
JPA_DIALECT=org.hibernate.dialect.H2Dialect
# JPA_DIALECT=org.hibernate.dialect.MySQLDialect  # MySQL 사용 시
JPA_DEFER_DATASOURCE_INIT=true
JPA_SQL_INIT_MODE=never

# --- Hibernate 성능 설정 ---
JPA_BATCH_SIZE=50                   # JDBC 배치 크기 (대량 INSERT/UPDATE 최적화)
JPA_ORDER_INSERTS=true              # INSERT 문 그룹화
JPA_ORDER_UPDATES=true              # UPDATE 문 그룹화
JPA_QUERY_PLAN_CACHE_SIZE=2048      # 쿼리 플랜 캐시 크기

# ===========================================
# 5. H2 콘솔 (local 전용)
# ===========================================
H2_CONSOLE_ENABLED=true             # local: true, prod: false
H2_CONSOLE_PATH=/h2-console

# ===========================================
# 6. Redis
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2000ms

# --- Redis 커넥션 풀 ---
REDIS_MAX_ACTIVE=8                  # 최대 활성 커넥션
REDIS_MAX_IDLE=8                    # 최대 유휴 커넥션
REDIS_MIN_IDLE=0                    # 최소 유휴 커넥션
REDIS_MAX_WAIT=-1ms                 # 커넥션 대기 시간 (-1=무제한)
REDIS_SHUTDOWN_TIMEOUT=100ms        # 종료 시 타임아웃

# ===========================================
# 7. 캐시 및 세션
# ===========================================
CACHE_TYPE=simple                   # local: simple, prod: redis
SESSION_STORE_TYPE=none             # local: none, prod: redis
CACHE_TTL=600000                    # 캐시 TTL (ms, 기본 10분)
CACHE_NULL_VALUES=false
CACHE_KEY_PREFIX=music-sale:
REDIS_HEALTH_CHECK_ENABLED=false    # local: false, prod: true

# ===========================================
# 8. JWT 인증
# ===========================================
# 중요: 프로덕션에서는 반드시 안전한 시크릿 키로 변경하세요!
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-secure-at-least-256-bits
JWT_ACCESS_TOKEN_VALIDITY=3600000       # Access Token 유효기간 (1시간)
JWT_REFRESH_TOKEN_VALIDITY=1209600000   # Refresh Token 유효기간 (14일)

# ===========================================
# 9. OAuth2 설정
# ===========================================
OAUTH2_FRONTEND_REDIRECT_URI=http://localhost:3000/oauth2/redirect

# --- Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Naver ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Kakao ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ===========================================
# 10. 로깅
# ===========================================
LOGGING_LEVEL_COM_MUSIC_SALE=DEBUG      # local: DEBUG, prod: WARN
LOGGING_LEVEL_SECURITY=INFO             # local: DEBUG, prod: INFO
LOGGING_LEVEL_HIBERNATE_SQL=DEBUG       # local: DEBUG, prod: INFO
LOGGING_LEVEL_HIBERNATE_PARAMS=TRACE    # local: TRACE, prod: INFO

# ===========================================
# 11. API 문서 (Swagger/OpenAPI)
# ===========================================
API_DOCS_PATH=/v3/api-docs
API_DOCS_ENABLED=true               # local/dev: true, prod: false
SWAGGER_UI_PATH=/swagger-ui.html
SWAGGER_OPERATIONS_SORTER=method
SWAGGER_TAGS_SORTER=alpha
SWAGGER_DOC_EXPANSION=none

# ===========================================
# 12. 모니터링 (Actuator)
# ===========================================
ACTUATOR_ENDPOINTS=health,info,metrics,env
ACTUATOR_BASE_PATH=/actuator
ACTUATOR_HEALTH_SHOW_DETAILS=always     # local: always, prod: when-authorized
ACTUATOR_HEALTH_SHOW_COMPONENTS=always
ACTUATOR_METRICS_ENABLED=true
ACTUATOR_PROMETHEUS_ENABLED=false       # Prometheus 연동 시 true
