#!/bin/sh
# Spotless check and auto-fix before commit

# Determine which gradle command to use
if [ -f "./gradlew-local.bat" ]; then
    GRADLE_CMD="./gradlew-local.bat"
else
    GRADLE_CMD="./gradlew"
fi

echo "🔍 Checking code formatting..."

$GRADLE_CMD spotlessCheck --quiet

RESULT=$?

if [ $RESULT -ne 0 ]; then
    echo ""
    echo "⚠️  Code formatting issues detected!"
    echo "🔧 Automatically applying Spotless formatting..."
    echo ""

    $GRADLE_CMD spotlessApply --quiet

    if [ $? -eq 0 ]; then
        echo ""
        echo "✅ Formatting applied successfully!"
        echo "📝 Please review the changes and add them to your commit:"
        echo ""
        echo "   git add -u"
        echo "   git commit --amend --no-edit"
        echo ""
        exit 1
    else
        echo ""
        echo "❌ Failed to apply formatting!"
        exit 1
    fi
fi

echo "✅ Code formatting is correct!"
exit 0
